# =========================================================================
# Azure AI Foundry — project "azure-multiagent-proj" (user-provisioned)
# =========================================================================
# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/azure-multiagent-proj
AZURE_AI_PROJECT_ENDPOINT=
AZURE_TENANT_ID=

# Chat deployment used for ALL specialist agents (Foundry Agent Service)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.6-sol
# Chat deployment used for classifier / synthesizer / fact-extractor (same deployment is fine)
CLASSIFIER_MODEL_DEPLOYMENT=gpt-5.6-sol

# =========================================================================
# Azure OpenAI — embeddings (used by embeddings.py and db-seeding)
# =========================================================================
# Either call Azure OpenAI directly (endpoint+key) OR go through the embedding Function (EMBEDDING_FUNCTION_URL).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
# Optional: deployed embedding Azure Function (POST /embed). If set, embeddings.py prefers this.
EMBEDDING_FUNCTION_URL=

# =========================================================================
# MongoDB Atlas — cluster "FabricCluster", DB "multi-agent"
# =========================================================================
MONGODB_URI=mongodb+srv://<user>:<pass>@fabriccluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=multi-agent

# =========================================================================
# Self-hosted MongoDB MCP Server (Azure Container Apps)
# The agents call a self-hosted `mongodb/mongodb-mcp-server` over Streamable HTTP at <fqdn>/mcp.
# deploy.sh deploys it (deploy/mcp.bicep) and writes MONGODB_MCP_URL into .env.live. The MCP
# container holds the MongoDB connection string, so agents never handle DB credentials.
#
# For LOCAL dev, run the MCP in Docker and point MONGODB_MCP_URL at it:
#   docker run --rm -p 3000:3000 -e MDB_MCP_CONNECTION_STRING="$MONGODB_URI" \
#     -e MDB_MCP_TRANSPORT=http -e MDB_MCP_HTTP_HOST=0.0.0.0 -e MDB_MCP_HTTP_PORT=3000 \
#     -e MDB_MCP_READ_ONLY=true mongodb/mongodb-mcp-server:latest
# =========================================================================
MONGODB_MCP_URL=http://localhost:3000/mcp

# API-key header hardening for an externally-exposed MCP endpoint. The MCP validates this exact
# header (name = MCP_API_KEY_HEADER, value = MCP_API_KEY). The header name is NON-Authorization so
# the same tool can be registered on Foundry agents. Leave MCP_API_KEY blank for an unauthenticated
# local/internal MCP. deploy.sh GENERATES a key and stores it in Key Vault for the cloud stack.
MCP_API_KEY=
MCP_API_KEY_HEADER=X-MCP-Api-Key

# Azure Key Vault (secrets store) — set automatically for the cloud stack; blank for local runs.
AZURE_KEY_VAULT_URL=

# =========================================================================
# Behavior toggles
# =========================================================================
# Routing backend: heuristic | llm | auto  (auto = heuristic first, LLM tie-breaker)
CLASSIFIER_BACKEND=auto
# How specialists execute on the Azure AI Foundry Agent Service:
#   registered-or-inline (default) — invoke registered Foundry prompt agents, fall back to inline
#   registered                     — strict: only registered prompt agents (error if unavailable)
#   inline | disabled              — always run inline via the raw Responses API (no registration)
# The self-hosted MCP uses a STATIC API-key header (not an expiring OAuth token), so the registered
# path no longer suffers the ~1h-token 424 problem. Register agents with:
#   python -m scripts.provision_agents sync   (needs requirements-foundry.txt)
SPECIALIST_MODE=registered-or-inline
# Safety: keep MCP writes off for the demo (the MCP also runs read-only by default)
MONGODB_ALLOW_WRITE=false

PORT=3000

# =========================================================================
# Observability (Azure Monitor + OpenTelemetry) — optional
# Leave the connection string blank to run fully offline (telemetry no-ops). deploy.sh / main.bicep
# set APPLICATIONINSIGHTS_CONNECTION_STRING automatically for the cloud stack.
# =========================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_ENABLED=true
OTEL_SERVICE_NAME=career-assistant-api

# Cost estimation (USD per 1M tokens) — used only for the "Total cost" metric in the UI/dashboard.
# Defaults track Azure OpenAI gpt-4o list pricing; override to match your deployed model.
PRICE_INPUT_PER_1M=2.50
PRICE_OUTPUT_PER_1M=10.00
