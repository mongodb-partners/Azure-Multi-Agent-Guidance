# =========================================================================
# Azure AI Foundry — project "azure-multiagent-proj" (user-provisioned)
# =========================================================================
# Project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/azure-multiagent-proj
AZURE_AI_PROJECT_ENDPOINT=
AZURE_TENANT_ID=

# Chat deployment used for ALL specialist agents (Foundry Agent Service)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.6-sol
# Chat deployment used for classifier / synthesizer / fact-extractor (same deployment is fine)
CLASSIFIER_MODEL_DEPLOYMENT=gpt-5.6-sol

# =========================================================================
# Azure OpenAI — embeddings (used by embeddings.py and db-seeding)
# =========================================================================
# Either call Azure OpenAI directly (endpoint+key) OR go through the embedding Function (EMBEDDING_FUNCTION_URL).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
# Optional: deployed embedding Azure Function (POST /embed). If set, embeddings.py prefers this.
EMBEDDING_FUNCTION_URL=

# =========================================================================
# MongoDB Atlas — cluster "FabricCluster", DB "multi-agent"
# =========================================================================
MONGODB_URI=mongodb+srv://<user>:<pass>@fabriccluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=multi-agent
# Reused MongoDB MCP Container App (connection string already targets FabricCluster; db passed per-query)
MONGODB_MCP_URL=https://mongo-mcp-without-auth11may.happyground-0d54aef3.eastus.azurecontainerapps.io/mcp

# =========================================================================
# Behavior toggles
# =========================================================================
# Routing backend: heuristic | llm | auto  (auto = heuristic first, LLM tie-breaker)
CLASSIFIER_BACKEND=auto
# Orchestration: classifier (default, ported custom router) | maf-handoff (MAF built-in handoff)
ORCHESTRATOR_MODE=classifier
# How specialists execute:
#   registered-or-inline (default) — invoke registered Foundry prompt agents, fall back to inline
#   registered                     — strict: only registered prompt agents (error if unavailable)
#   inline | disabled              — always run inline via the raw Responses API (no registration)
# Register agents first with:  python -m scripts.provision_agents sync  (needs requirements-foundry.txt)
SPECIALIST_MODE=registered-or-inline
# Safety: keep MCP writes off for the demo
MONGODB_ALLOW_WRITE=false

PORT=3000
