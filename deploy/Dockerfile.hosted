# Foundry HOSTED whole-solution agent — the entire orchestrator behind one Responses endpoint.
# Built by deploy/provision_hosted.sh, then registered as a HostedAgentDefinition. The Foundry
# runtime runs this container and routes Responses calls to it on port 8088.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# Core deps + the optional Foundry stack (Responses protocol server, azure-ai-projects).
COPY requirements.txt requirements-foundry.txt ./
RUN pip install -r requirements.txt -r requirements-foundry.txt

COPY src/ ./src/
COPY config/ ./config/

# The whole-solution agent is self-contained: run specialists inline (no dependency on the
# separately-registered prompt agents). Override to "registered" to delegate to them instead.
ENV SPECIALIST_MODE=inline \
    HOSTED_PORT=8088

EXPOSE 8088
CMD ["python", "-m", "src.hosted_agent"]
