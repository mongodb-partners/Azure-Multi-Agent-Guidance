# FastAPI + SSE orchestrator API
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# Core deps + Foundry Agent Service SDK (azure-ai-projects) so the API can invoke the
# registered prompt agents on the Foundry managed runtime (SPECIALIST_MODE=registered).
COPY requirements.txt requirements-foundry.txt ./
RUN pip install -r requirements.txt -r requirements-foundry.txt

COPY src/ ./src/
COPY config/ ./config/

EXPOSE 3000
CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "3000"]
