# Keep the ACR/Docker build context small. Note: ACR applies this SAME .dockerignore
# to every image build, so we must NOT exclude paths that any Dockerfile needs to COPY:
#   - Dockerfile.api    → src/ config/
#   - Dockerfile.ui     → ui/
#   - Dockerfile.hosted → src/ config/
# Everything below is dev-only and safe to exclude from all three.
.venv
.venv-foundry
.venv-maf
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.git
.gitignore
.env
.env.*
*.log
.DS_Store
notebooks
tests
docs
